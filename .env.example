# Application Configuration
APP_PORT=8081
APP_ENV=development
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s

# Database Configuration
DATABASE_MASTER_DSN=postgres://postgres:postgres@localhost:5432/loyalty_databases?sslmode=disable
DATABASE_REPLICA_DSN=postgres://postgres:postgres@localhost:5432/loyalty_databases?sslmode=disable
DATABASE_MAX_CONNS=50
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_IDLE=5m
DATABASE_MAX_CONN_LIFE=1h

# JWT Configuration
JWT_SECRET=loyalty-engine-super-secret-key-change-in-production
JWT_SIGNING_METHOD=HS256

# Workers Configuration
WORKERS_OUTBOX_POLL_INTERVAL_SECS=5
WORKERS_EXPIRY_BATCH_CRON=0 * * * *
WORKERS_EXPIRY_BATCH_SIZE=500

